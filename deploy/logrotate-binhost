# 镜像机上我们自己产生的日志。install.sh 装到 /etc/logrotate.d/binhost。
#
# nginx 的 /var/log/nginx/*.log 由 nginx ebuild 自带的配置管，不重复写。
# net-misc/rsync 自带的配置管的是 /var/log/rsync.log，我们的 rsyncd.conf
# 写的是 rsyncd.log，差一个字母，那份配置一直管着一个不存在的文件。

/var/log/rsyncd.log {
	weekly
	rotate 8
	size 10M
	compress
	delaycompress
	notifempty
	missingok
	# rsyncd 常驻并持有文件句柄，只能截断不能改名
	copytruncate
}

# daily.sh 每天往 run.log 追加一轮的输出，emirrordist 自己写另外几份。
/var/log/emirrordist/*.log {
	weekly
	rotate 8
	compress
	delaycompress
	notifempty
	missingok
	create 0644 root root
}
